   "source": [
    "df[\"TenureBins\"] = pd.cut(df[\"tenure\"], bins=3, labels=[\"Bassa\", \"Media\", \"Alta\"])\n",
    "df[\"Churn\"] = df[\"Churn\"].map({ \"Yes\": 1, \"No\": 0 })\n",
    "pd.pivot_table(df, index=\"TenureBins\", columns=\"Contract\", values=\"Churn\", aggfunc=\"mean\", observed=False)"
   ]
  },
