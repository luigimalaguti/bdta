   "source": [
    "mask_woman = X_test[\"gender\"] == 0\n",
    "mask_man = X_test[\"gender\"] == 1\n",
    "mask_churn = y_test == 1\n",
    "\n",
    "probability_churn_woman = X_test[mask_woman & mask_churn].shape[0] / X_test[mask_woman].shape[0]\n",
    "probability_churn_man = X_test[mask_man & mask_churn].shape[0] / X_test[mask_man].shape[0]\n",
    "\n",
    "print(\"Probability of leaving for women:\", probability_churn_woman)\n",
    "print(\"Probability of leaving for men:\", probability_churn_man)"
   ]
