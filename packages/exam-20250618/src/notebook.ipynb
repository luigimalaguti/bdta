   "source": [
    "### Domanda 03 (Punti 2)\n",
    "\n",
    "A partire dal dataset utilizzato al punto 1, trovare i migliori parametri di `max_depth` e `n_estimators` in RandomForestClassifier. Come cambia l'F1-score?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "3DgEDagxswRV"
   },
   "outputs": [],
   "source": [
    "df = pd.read_csv(\"dataset.csv\")\n",
    "df.drop(\"customerID\", axis=1, inplace=True)\n",
    "df.dropna(inplace=True)\n",
    "df.drop_duplicates(inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "xLq3samX7S5k"
   },
   "outputs": [],
   "source": [
    "categorical_columns = [\"OnlineSecurity\", \"OnlineBackup\", \"DeviceProtection\", \"TechSupport\", \"StreamingTV\", \"StreamingMovies\"]\n",
    "unique_values = {value for column in df[categorical_columns] for value in df[column].unique()}\n",
    "df[extra_services] = df[categorical_columns].apply(\n",
    "    lambda column: column.map(\n",
    "        { key: 1 if key == \"Yes\" else 0 for key in unique_values }\n",
    "    )\n",
    ")\n",
    "df[\"TotalCharges\"] = pd.to_numeric(df[\"TotalCharges\"], errors=\"coerce\").fillna(0)\n",
    "encoder = LabelEncoder()\n",
    "categorical_columns = df.select_dtypes(include=\"object\").columns\n",
    "df[categorical_columns] = df[categorical_columns].apply(encoder.fit_transform)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "Ev5JrTig0tuz"
   },
   "outputs": [],
   "source": [
    "X, y = df.drop(\"Churn\", axis=1), df[\"Churn\"]\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=1/4, random_state=0, stratify=y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
