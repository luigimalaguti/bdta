   "source": [
    "### Domanda 06\n",
    "\n",
    "**Analisi della feature importance**: verificare se i risultati ottenuti al punto precedente sono confermati dalla tecnica Leave-One-Covariate-Out (ovvero escludo una feature alla volta e vedo come variano le performance del modello)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "pPSIF7qpuhXZ"
   },
   "outputs": [],
   "source": [
    "features = X_test.columns\n",
    "f1_drops = []\n",
    "\n",
    "for feature in features:\n",
    "      X_train_dropped = X_train.drop(feature, axis=1)\n",
    "      X_test_dropped = X_test.drop(feature, axis=1)\n",
    "      sgd.fit(X_train_dropped, y_train)\n",
    "      y_pred_dropped = sgd.predict(X_test_dropped)\n",
    "      f1_dropped = f1_score(y_test, y_pred_dropped)\n",
    "      f1_drops.append(f1_dropped)"
   ]
